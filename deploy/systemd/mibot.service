# Generate after foreground account verification; see INSTALL.md.
[Unit]
Description=MiBot
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=@ROOT@
ExecStart=@NODE@ @RUNTIME@ --serve
Environment=@PATH@
Environment=NODE_ENV=production
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
KillMode=control-group
TimeoutStopSec=60s
SendSIGKILL=yes
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mibot

[Install]
WantedBy=multi-user.target
